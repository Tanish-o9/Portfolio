# EmailJS Configuration (Client-side Public Keys Only)
# 1. Sign up at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> get Service ID
# 3. Create an Email Template -> get Template ID
# 4. Copy your Public Key from Account > General
VITE_EMAILJS_SERVICE_ID=service_your_id
VITE_EMAILJS_TEMPLATE_ID=template_your_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
